# Server-only Cloudinary credentials. Add these in Vercel Project Settings.
# Never put the API secret in browser JavaScript or commit a populated .env file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The existing Firebase project used to authorize evidence API requests.
FIREBASE_PROJECT_ID=civicresolve-ai-3d54c

# Server-only Gemini authentication key from Google AI Studio.
# The model is configurable so it can be upgraded without changing source code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
