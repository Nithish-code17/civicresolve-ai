.stat-card small { color: #879893; font-size: 11px; }
.compact-stats .stat-card { padding: 16px; }
.compact-stats .stat-card strong { font-size: 24px; }

.two-column-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; box-shadow: 0 10px 30px rgba(31,63,56,.05); overflow: hidden; }
.panel-header { padding: 20px 22px 15px; display: flex; justify-content: space-between; gap: 18px; align-items: flex-start; }
.panel-header h3 { margin: 0 0 4px; font: 800 17px "Manrope"; }
.panel-header p { margin: 0; color: var(--muted); font-size: 12px; }
.chart-box { padding: 10px 22px 24px; min-height: 300px; }

.donut-wrap { display: grid; grid-template-columns: 190px 1fr; gap: 24px; align-items: center; }
.donut { width: 180px; height: 180px; border-radius: 50%; position: relative; margin: auto; }
.donut::after { content: ""; position: absolute; inset: 38px; background: white; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line); }
.donut-center { position: absolute; inset: 0; display: grid; place-items: center; z-index: 2; text-align: center; }
.donut-center strong { display: block; font: 800 27px "Manrope"; }
.donut-center span { color: var(--muted); font-size: 11px; }
.legend-list { display: grid; gap: 10px; }
.legend-item { display: grid; grid-template-columns: 10px 1fr auto; gap: 9px; align-items: center; font-size: 11px; }
.legend-dot { width: 10px; height: 10px; border-radius: 50%; }
.legend-item span { color: var(--muted); }

.bar-list { display: grid; gap: 16px; padding-top: 10px; }
.bar-row { display: grid; grid-template-columns: 125px 1fr 30px; gap: 12px; align-items: center; font-size: 11px; }
.bar-row > span:first-child { color: #4f625e; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar-track { height: 13px; border-radius: 999px; background: #edf2f0; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999px; min-width: 8px; }
.bar-value { text-align: right; font-weight: 800; }

.table-scroll { overflow-x: auto; }
.data-table { width: 100%; border-collapse: collapse; min-width: 800px; }
.data-table th, .data-table td { padding: 15px 18px; text-align: left; border-top: 1px solid #edf2f0; font-size: 12px; vertical-align: middle; }
.data-table th { color: #70827e; font-size: 10px; text-transform: uppercase; letter-spacing: .08em; background: #fbfcfc; }
.data-table td strong { display: block; font-size: 12px; }
.table-subtext { display: block; color: #83938f; margin-top: 4px; font-size: 10px; }
.badge { display: inline-flex; align-items: center; border-radius: 999px; padding: 5px 9px; font-size: 10px; font-weight: 800; white-space: nowrap; }
.priority-high { color: #a93434; background: #fde7e7; }
.priority-medium { color: #976511; background: #fff0d3; }
.priority-low { color: #2d7157; background: #e4f4ec; }
.status-submitted { color: #5f6071; background: #ededf2; }
.status-under-review { color: #72529a; background: #f0e8fa; }
.status-assigned { color: #9a6812; background: #fff1d7; }
.status-in-progress { color: #326d9b; background: #e6f1f9; }
.status-resolved { color: #277255; background: #e3f4eb; }
.table-actions { display: flex; align-items: center; gap: 8px; }
.table-button { border: 1px solid var(--line); background: white; color: var(--primary); font-weight: 700; border-radius: 8px; padding: 7px 10px; }
.delete-button { border: 0; background: #fae8e8; color: var(--danger); display: grid; place-items: center; border-radius: 8px; padding: 7px 9px; }
.empty-table { padding: 40px; text-align: center; color: var(--muted); }

.form-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, .6fr); gap: 22px; align-items: start; }
.form-card, .analysis-card, .tracking-result, .success-page { background: white; border: 1px solid var(--line); border-radius: 22px; padding: 26px; box-shadow: var(--shadow); }
.analysis-card { position: sticky; top: 120px; min-height: 440px; }
.section-heading { display: flex; gap: 13px; align-items: flex-start; margin-bottom: 24px; }
.section-heading.compact { margin-bottom: 18px; }
.section-heading h2, .section-heading h3 { margin: 0 0 5px; font: 800 20px "Manrope"; }
.section-heading h3 { font-size: 17px; }
.section-heading p { margin: 0; color: var(--muted); font-size: 12px; }
.section-icon { width: 44px; height: 44px; border-radius: 13px; display: grid; place-items: center; background: var(--primary-soft); color: var(--primary); flex: 0 0 auto; font-size: 19px; }
.section-icon.purple { background: #f0e9f8; color: var(--purple); }
.form-grid.two { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.field-label { display: grid; gap: 7px; margin-bottom: 17px; }
.field-label > span { font-size: 12px; font-weight: 700; color: #3d514d; }
input, textarea, select { width: 100%; border: 1px solid #cfddda; background: #fbfdfc; border-radius: 10px; padding: 12px 13px; color: var(--ink); outline: none; }
textarea { resize: vertical; line-height: 1.55; }
input:focus, textarea:focus, select:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(31,111,95,.1); background: white; }
.form-note { display: flex; gap: 9px; align-items: center; padding: 12px; border-radius: 10px; background: #eff7f4; color: #41645c; font-size: 11px; margin-bottom: 17px; }
.analysis-results { display: grid; gap: 10px; }
.analysis-item { padding: 13px 0; border-bottom: 1px solid var(--line); }
.analysis-item span, .analysis-item strong { display: block; }
.analysis-item span { color: var(--muted); font-size: 11px; margin-bottom: 4px; }
.analysis-item strong { font-size: 13px; }
.smart-message { margin-top: 12px; padding: 14px; border-radius: 12px; background: #f4effa; color: #6d419d; display: flex; gap: 9px; align-items: flex-start; }
.smart-message p { margin: 0; font-size: 11px; line-height: 1.55; }
.empty-analysis { min-height: 310px; display: grid; place-items: center; align-content: center; text-align: center; color: #91a19d; padding: 20px; }
.empty-analysis .big-icon { font-size: 40px; }
.empty-analysis h3 { color: var(--ink); margin: 14px 0 7px; font: 700 16px "Manrope"; }
.empty-analysis p { margin: 0; font-size: 12px; line-height: 1.6; }
.success-page { max-width: 720px; margin: 20px auto; text-align: center; }
.success-icon { width: 88px; height: 88px; border-radius: 50%; margin: 0 auto 18px; display: grid; place-items: center; background: #e3f4eb; color: var(--success); font-size: 42px; }
.success-page h2 { margin: 6px 0 8px; font: 800 32px "Manrope"; }
.success-page > p:not(.eyebrow) { color: var(--muted); }
.result-card { border: 1px solid var(--line); border-radius: 14px; margin: 24px 0; text-align: left; overflow: hidden; }
.result-row { display: flex; justify-content: space-between; gap: 20px; padding: 13px 15px; border-bottom: 1px solid var(--line); font-size: 12px; }
.result-row:last-child { border-bottom: 0; }
.result-row span { color: var(--muted); }
.button-row { display: flex; gap: 10px; flex-wrap: wrap; }
.button-row.center { justify-content: center; margin-top: 22px; }
.button-row.end { justify-content: flex-end; margin-top: 22px; }
.alert { display: flex; gap: 10px; align-items: center; border-radius: 12px; padding: 14px 16px; font-size: 12px; }
.alert.warning { background: #fff5df; color: #8e6218; }
.alert.error { background: #fde9e9; color: #9e3434; }

.track-hero { text-align: center; padding: 42px 24px; border-radius: 22px; color: white; background: linear-gradient(125deg, #174e43, #255f54); box-shadow: var(--shadow); }
.track-icon { width: 70px; height: 70px; border-radius: 20px; display: grid; place-items: center; margin: 0 auto 17px; background: rgba(255,255,255,.13); font-size: 33px; }
.track-hero .eyebrow { color: #c4e4dc; }
