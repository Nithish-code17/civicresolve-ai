.track-hero h2 { font: 800 32px "Manrope"; margin: 8px 0; }
.track-hero > p:not(.eyebrow) { color: #d7e9e4; margin: 0 0 20px; }
.track-search { display: flex; max-width: 620px; margin: auto; padding: 6px; background: white; border-radius: 14px; }
.track-search input { border: 0; background: white; box-shadow: none; }
.track-search input:focus { box-shadow: none; }
.sample-link { margin-top: 13px; border: 0; background: transparent; color: #c9e5df; text-decoration: underline; font-size: 11px; }
.tracking-header { display: flex; justify-content: space-between; gap: 20px; align-items: flex-start; border-bottom: 1px solid var(--line); padding-bottom: 19px; }
.tracking-header h2 { margin: 6px 0 11px; font: 800 24px "Manrope"; }
.details-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 13px; margin: 20px 0; }
.detail-card { border: 1px solid var(--line); border-radius: 13px; padding: 14px; display: flex; gap: 10px; align-items: flex-start; color: var(--primary); }
.detail-card .detail-icon { font-size: 18px; }
.detail-card span, .detail-card strong { display: block; }
.detail-card span { color: var(--muted); font-size: 10px; margin-bottom: 4px; }
.detail-card strong { color: var(--ink); font-size: 11px; line-height: 1.4; }
.description-block { background: #f8fbfa; border-radius: 13px; padding: 16px; }
.description-block strong { font-size: 12px; }
.description-block p { margin: 7px 0 0; color: var(--muted); line-height: 1.65; font-size: 12px; }
.timeline-card { padding: 22px 0; }
.timeline-card h3, .feedback-card h3 { font: 800 16px "Manrope"; margin: 0 0 18px; }
.timeline { display: grid; grid-template-columns: repeat(5, 1fr); }
.timeline-step { position: relative; display: grid; justify-items: center; gap: 8px; color: #a4b0ad; font-size: 10px; text-align: center; }
.timeline-step::before { content: ""; position: absolute; height: 3px; width: 100%; top: 14px; left: -50%; background: #dfe8e5; z-index: 0; }
.timeline-step:first-child::before { display: none; }
.timeline-step.complete::before { background: var(--primary); }
.timeline-marker { width: 31px; height: 31px; border-radius: 50%; display: grid; place-items: center; background: #eef3f1; position: relative; z-index: 1; }
.timeline-step.complete { color: var(--primary); font-weight: 700; }
.timeline-step.complete .timeline-marker { background: var(--primary); color: white; }
.timeline-step.current .timeline-marker { box-shadow: 0 0 0 6px rgba(31,111,95,.12); }
.resolution-note { display: flex; gap: 11px; align-items: flex-start; border-radius: 13px; background: #e9f5f1; color: var(--primary); padding: 15px; }
.resolution-note strong { font-size: 12px; }
.resolution-note p { margin: 4px 0 0; color: #58726b; font-size: 11px; line-height: 1.5; }
.feedback-card { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--line); }
.feedback-card textarea { margin: 12px 0; }
.stars { display: flex; gap: 4px; }
.star { border: 0; background: transparent; color: #cbd3d1; padding: 2px; font-size: 26px; }
.star.active { color: #e5a53a; }

.filter-row { display: grid; grid-template-columns: 1fr 190px 160px; gap: 10px; padding: 0 20px 18px; }
.search-box { display: flex; align-items: center; gap: 7px; border: 1px solid #cfddda; background: #fbfdfc; border-radius: 10px; padding-left: 11px; color: #7d8c89; }
.search-box input { border: 0; box-shadow: none; background: transparent; padding-left: 2px; }
.search-box input:focus { box-shadow: none; }
.modal-backdrop { position: fixed; inset: 0; z-index: 100; background: rgba(10,35,29,.58); display: grid; place-items: center; padding: 20px; backdrop-filter: blur(5px); }
.modal { width: min(600px, 100%); max-height: 90vh; overflow-y: auto; background: white; border-radius: 20px; padding: 24px; box-shadow: 0 25px 70px rgba(0,0,0,.25); }
.modal-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px; }
.modal-header h2 { margin: 5px 0 0; font: 800 22px "Manrope"; }
.modal-summary { padding: 13px; border-radius: 11px; background: #f3f7f6; margin-bottom: 18px; }
.modal-summary strong, .modal-summary span { display: block; }
.modal-summary strong { font-size: 13px; }
.modal-summary span { font-size: 11px; color: var(--muted); margin-top: 4px; }

.insight-banner { display: flex; gap: 16px; align-items: center; padding: 22px; border-radius: 18px; border: 1px solid #e6d9f3; background: linear-gradient(115deg, #fbf8fe, #f1e9f9); }
.insight-banner h2 { margin: 5px 0 7px; font: 800 21px "Manrope"; }
.insight-banner p:not(.eyebrow) { margin: 0; color: #6d5a7e; font-size: 12px; line-height: 1.55; }
.toast { position: fixed; right: 25px; bottom: 25px; z-index: 200; background: #163f37; color: white; border-radius: 12px; padding: 13px 16px; box-shadow: 0 15px 40px rgba(0,0,0,.2); display: none; align-items: center; gap: 9px; font-size: 12px; }
.toast.show { display: flex; }

@media (max-width: 1150px) {
  .stats-grid { grid-template-columns: repeat(2, 1fr); }
  .hero-panel { grid-template-columns: 1fr; }
  .hero-visual { display: none; }
  .details-grid { grid-template-columns: repeat(2, 1fr); }
  .form-layout { grid-template-columns: 1fr; }
  .analysis-card { position: static; min-height: 0; }
}
@media (max-width: 900px) {
  .sidebar { transform: translateX(-100%); transition: transform .25s ease; }
  .sidebar.sidebar-open { transform: translateX(0); }
  .sidebar-close { display: inline-grid; }
  .sidebar-backdrop { display: block; position: fixed; inset: 0; background: rgba(8,31,26,.55); border: 0; z-index: 25; }
  .main-area { margin-left: 0; }
  .menu-button { display: inline-grid; }
  .topbar { padding: 15px 20px; justify-content: flex-start; gap: 12px; }
  .admin-chip { margin-left: auto; }
  .content-wrap { padding: 22px 20px 40px; }
}
@media (max-width: 720px) {
  .topbar h1 { font-size: 18px; }
  .admin-chip div:last-child { display: none; }
  .hero-panel { padding: 28px 22px; }
  .hero-panel h2 { font-size: 31px; }
  .two-column-grid, .stats-grid { grid-template-columns: 1fr; }
  .form-grid.two { grid-template-columns: 1fr; gap: 0; }
  .filter-row { grid-template-columns: 1fr; }
  .tracking-header { flex-direction: column; }
  .details-grid { grid-template-columns: 1fr; }
  .timeline { overflow-x: auto; grid-template-columns: repeat(5, 125px); padding: 8px 0; }
  .track-search { display: grid; gap: 7px; background: transparent; }
  .track-search input { border: 1px solid white; }
  .track-search .primary-button { width: 100%; background: #f1b94e; color: #173f37; }
  .panel-header { flex-direction: column; }
  .donut-wrap { grid-template-columns: 1fr; }
  .bar-row { grid-template-columns: 95px 1fr 26px; }
}
