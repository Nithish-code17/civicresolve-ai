rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn() && currentUser().data.role == role;
    }

    function isAdministrator() {
      return hasRole('administrator');
    }

    function isDepartmentOfficer() {
      return hasRole('department-officer');
    }

    function ownsComplaint(data) {
      return signedIn() && data.createdByUid == request.auth.uid;
    }

    function isAssignedDepartment(data) {
      return isDepartmentOfficer()
        && currentUser().data.department is string
        && currentUser().data.department == data.department;
    }

    function isValidRole(role) {
      return role in ['citizen', 'department-officer', 'administrator'];
    }

    function isValidDepartment(department) {
      return department in [
        'Public Works Department', 'Municipal Waste Department',
        'Water Supply Department', 'Electricity Department',
        'Sanitation Department', 'Transport Department',
        'Municipal Corporation', 'General Administration'
      ];
    }

    function roleDepartmentIsValid(role, department) {
      return (role == 'citizen' && department == '')
        || (role == 'department-officer' && isValidDepartment(department))
        || (role == 'administrator' && department == 'General Administration');
    }

    function userProfileIsValid(data, userId) {
      let required = [
        'uid', 'email', 'displayName', 'phone', 'role', 'department',
        'createdAt', 'updatedAt'
      ];
      let permitted = [
        'uid', 'email', 'displayName', 'phone', 'role', 'department',
        'createdAt', 'updatedAt', 'roleUpdatedAt', 'roleUpdatedBy',
        'roleUpdatedByName'
      ];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(permitted)
        && data.uid == userId
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 120
        && data.phone is string
        && data.phone.size() <= 20
        && isValidRole(data.role)
        && data.department is string
        && roleDepartmentIsValid(data.role, data.department)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('roleUpdatedAt' in data) || data.roleUpdatedAt is timestamp)
        && (!('roleUpdatedBy' in data) || data.roleUpdatedBy is string)
        && (!('roleUpdatedByName' in data) || data.roleUpdatedByName is string);
    }

    function administratorRoleUpdateIsValid(userId) {
      return request.auth.uid != userId
        && userProfileIsValid(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.roleUpdatedAt == request.time
        && request.resource.data.roleUpdatedBy == request.auth.uid
        && request.resource.data.roleUpdatedByName == currentUser().data.displayName
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'department', 'updatedAt', 'roleUpdatedAt', 'roleUpdatedBy', 'roleUpdatedByName']);
    }

    function complaintFieldsAreComplete(data) {
      let required = [
        'id', 'citizenName', 'email', 'phone', 'title', 'description',
        'location', 'category', 'department', 'priority', 'status',
        'expectedResolutionDate', 'resolutionNote', 'rating', 'feedback',
        'duplicateId', 'createdByUid', 'createdByEmail', 'createdAt',
        'updatedAt', 'statusHistory'
      ];
      let permitted = required.concat(['evidence', 'classification', 'sla', 'locationData']);
      return data.keys().hasAll(required) && data.keys().hasOnly(permitted);
    }

    function slaBaseDays(category) {
      return category == 'Roads & Potholes' ? 5
        : category in ['Waste Management', 'Water Supply', 'Electricity & Streetlights'] ? 2
        : category == 'Drainage & Sewage' ? 3
        : category in ['Public Transport', 'Parks & Public Spaces'] ? 4
        : 5;
    }

    function slaTargetDays(category, priority) {
      return priority == 'High'
        ? (category == 'Roads & Potholes' || category == 'General Civic Issue' ? 3
          : category in ['Drainage & Sewage', 'Public Transport', 'Parks & Public Spaces'] ? 2
          : 1)
        : priority == 'Low' ? slaBaseDays(category) + 2
        : slaBaseDays(category);
    }

    function slaIsValid(data) {
      let present = 'sla' in data;
      let item = present ? data.sla : {};
      return !present || (
        item is map
        && item.keys().hasAll([
          'policyVersion', 'baseDays', 'targetDays', 'deadlineAt',
          'deadlineDate', 'state', 'lastEvaluatedAt',
          'dueSoonAlertedAt', 'overdueAlertedAt'
        ])
        && item.keys().hasOnly([
          'policyVersion', 'baseDays', 'targetDays', 'deadlineAt',
          'deadlineDate', 'state', 'lastEvaluatedAt',
          'dueSoonAlertedAt', 'overdueAlertedAt'
        ])
        && item.policyVersion == 'civicresolve-sla-v1'
        && item.baseDays is int
        && item.baseDays >= 1
        && item.baseDays <= 7
        && item.targetDays is int
        && item.targetDays >= 1
        && item.targetDays <= 9
        && item.deadlineAt is timestamp
        && item.deadlineDate is string
        && item.deadlineDate.size() == 10
        && item.state in ['on-track', 'due-soon', 'overdue', 'resolved']
        && item.lastEvaluatedAt is timestamp
        && (item.dueSoonAlertedAt == null || item.dueSoonAlertedAt is timestamp)
        && (item.overdueAlertedAt == null || item.overdueAlertedAt is timestamp)
      );
    }

    function newSlaIsValid(data) {
      let item = data.sla;
      let targetDays = slaTargetDays(data.category, data.priority);
      return slaIsValid(data)
        && item.baseDays == slaBaseDays(data.category)
        && item.targetDays == targetDays
        && item.deadlineDate == data.expectedResolutionDate
        && item.state == 'on-track'
        && item.lastEvaluatedAt == request.time
        && item.dueSoonAlertedAt == null
        && item.overdueAlertedAt == null
        && item.deadlineAt >= request.time + duration.value(targetDays, 'd') - duration.value(10, 'm')
        && item.deadlineAt <= request.time + duration.value(targetDays, 'd') + duration.value(10, 'm');
    }

    function classificationIsValid(data) {
      let present = 'classification' in data;
      let item = present ? data.classification : {};
      return !present || (
        item is map
        && item.keys().hasAll([
          'source', 'model', 'confidence', 'summary', 'reasoning',
          'reviewRequired', 'safetyOverride'
        ])
        && item.keys().hasOnly([
          'source', 'model', 'confidence', 'summary', 'reasoning',
          'reviewRequired', 'safetyOverride'
        ])
        && item.source in ['gemini', 'rules']
        && item.model is string
        && item.model.size() >= 1
        && item.model.size() <= 80
        && item.confidence is int
        && item.confidence >= 0
        && item.confidence <= 100
        && item.summary is string
        && item.summary.size() >= 1
        && item.summary.size() <= 220
        && item.reasoning is string
        && item.reasoning.size() >= 1
        && item.reasoning.size() <= 300
        && item.reviewRequired is bool
        && item.safetyOverride is bool
      );
    }

    function locationDataIsValid(data) {
      let present = 'locationData' in data;
      let item = present ? data.locationData : {};
      return !present || (
        item is map
        && item.keys().hasAll([
          'latitude', 'longitude', 'address', 'ward', 'source', 'accuracyMeters'
        ])
        && item.keys().hasOnly([
          'latitude', 'longitude', 'address', 'ward', 'source', 'accuracyMeters'
        ])
        && item.latitude is number
        && item.latitude >= -90
        && item.latitude <= 90
        && item.longitude is number
        && item.longitude >= -180
        && item.longitude <= 180
        && item.address is string
        && item.address == data.location
        && item.address.size() >= 3
        && item.address.size() <= 500
        && item.ward is string
        && item.ward.size() <= 120
        && item.source in ['map-pin', 'device', 'address-search']
        && (item.accuracyMeters == null || (
          item.accuracyMeters is number
          && item.accuracyMeters >= 0
          && item.accuracyMeters <= 100000
        ))
      );
    }

    function evidenceItemIsValid(item, complaintId, ownerUid) {
      return item is map
        && item.keys().hasAll([
          'provider', 'complaintId', 'assetId', 'publicId',
          'resourceType', 'deliveryType', 'format', 'originalName',
          'contentType', 'size', 'uploadedAt', 'uploadedByUid'
        ])
        && item.keys().hasOnly([
          'provider', 'complaintId', 'assetId', 'publicId',
          'resourceType', 'deliveryType', 'format', 'originalName',
          'contentType', 'size', 'uploadedAt', 'uploadedByUid'
        ])
        && item.provider == 'cloudinary'
        && item.complaintId == complaintId
        && item.assetId is string
        && item.assetId.size() >= 1
        && item.assetId.size() <= 120
        && item.publicId is string
        && item.publicId.matches(
          'civicresolve/complaint-evidence/' + complaintId + '/' + ownerUid
            + '/evidence-[1-3]([.]pdf)?'
        )
        && item.publicId.size() <= 240
        && item.resourceType in ['image', 'raw']
        && item.deliveryType == 'authenticated'
        && item.format in ['jpg', 'jpeg', 'png', 'webp', 'pdf']
        && item.originalName is string
        && item.originalName.size() >= 1
        && item.originalName.size() <= 150
        && item.contentType in [
          'image/jpeg', 'image/png', 'image/webp', 'application/pdf'
        ]
        && item.size is int
        && item.size > 0
        && item.size <= 5 * 1024 * 1024
        && item.uploadedAt is timestamp
        && item.uploadedByUid == ownerUid
        && (
          (item.contentType == 'image/jpeg'
            && item.resourceType == 'image'
            && item.format in ['jpg', 'jpeg'])
          || (item.contentType == 'image/png'
            && item.resourceType == 'image'
            && item.format == 'png')
          || (item.contentType == 'image/webp'
            && item.resourceType == 'image'
            && item.format == 'webp')
          || (item.contentType == 'application/pdf'
            && item.resourceType == 'raw'
            && item.format == 'pdf')
        );
    }

    function evidenceIsValid(data, complaintId) {
      let present = 'evidence' in data;
      let items = present ? data.evidence : [];
      return items is list
        && items.size() <= 3
        && (items.size() < 1 || evidenceItemIsValid(items[0], complaintId, data.createdByUid))
        && (items.size() < 2 || evidenceItemIsValid(items[1], complaintId, data.createdByUid))
        && (items.size() < 3 || evidenceItemIsValid(items[2], complaintId, data.createdByUid));
    }

    function complaintFieldsHaveValidTypes(data, complaintId) {
      return data.id is string
        && data.id == complaintId
        && data.id.size() <= 80
        && data.citizenName is string
        && data.citizenName.size() >= 2
        && data.citizenName.size() <= 120
        && data.email is string
        && data.email.size() <= 254
        && data.phone is string
        && data.phone.size() <= 20
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 160
        && data.description is string
        && data.description.size() >= 15
        && data.description.size() <= 5000
        && data.location is string
        && data.location.size() >= 3
        && data.location.size() <= 500
        && data.category in [
          'Roads & Potholes', 'Waste Management', 'Water Supply',
          'Electricity & Streetlights', 'Drainage & Sewage',
          'Public Transport', 'Parks & Public Spaces',
          'General Civic Issue'
        ]
        && data.department in [
          'Public Works Department', 'Municipal Waste Department',
          'Water Supply Department', 'Electricity Department',
          'Sanitation Department', 'Transport Department',
          'Municipal Corporation', 'General Administration'
        ]
        && data.priority in ['High', 'Medium', 'Low']
        && data.status in ['Submitted', 'Under Review', 'Assigned', 'In Progress', 'Resolved']
        && data.expectedResolutionDate is string
        && data.expectedResolutionDate.size() == 10
        && data.resolutionNote is string
        && data.resolutionNote.size() <= 3000
        && (data.rating == null || (data.rating is int && data.rating >= 1 && data.rating <= 5))
        && data.feedback is string
        && data.feedback.size() <= 1000
        && data.duplicateId is string
        && data.duplicateId.size() <= 80
        && data.createdByUid is string
        && data.createdByEmail is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.statusHistory is list
        && data.statusHistory.size() >= 1
        && data.statusHistory.size() <= 100
        && slaIsValid(data)
        && classificationIsValid(data)
        && locationDataIsValid(data)
        && evidenceIsValid(data, complaintId);
    }

    function initialHistoryIsValid(data) {
      let entry = data.statusHistory[0];
      return data.statusHistory.size() == 1
        && entry.status == 'Submitted'
        && entry.note is string
        && entry.note.size() <= 3000
        && entry.changedAt is timestamp
        && entry.changedByUid == request.auth.uid
        && entry.changedByName is string
        && entry.changedByRole == 'citizen';
    }

    function historyAppendIsValid() {
      let newHistory = request.resource.data.statusHistory;
      let oldHistory = resource.data.statusHistory;
      let entry = newHistory[newHistory.size() - 1];
      return newHistory.size() == oldHistory.size() + 1
        && newHistory.hasAll(oldHistory)
        && entry.status == request.resource.data.status
        && entry.note is string
        && entry.note.size() <= 3000
        && entry.changedAt is timestamp
        && entry.changedByUid == request.auth.uid
        && entry.changedByName is string
        && entry.changedByRole == currentUser().data.role;
    }

    function officialProgressUpdateIsValid(complaintId) {
      return request.resource.data.id == resource.data.id
        && request.resource.data.id == complaintId
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in [
          'Submitted', 'Under Review', 'Assigned', 'In Progress', 'Resolved'
        ]
        && request.resource.data.resolutionNote is string
        && request.resource.data.resolutionNote.size() <= 3000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.statusHistory is list
        && request.resource.data.statusHistory.size() <= 100
        && historyAppendIsValid();
    }

    function citizenFeedbackUpdateIsValid() {
      return request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() <= 1000
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'feedback', 'updatedAt']);
    }

    function citizenEvidenceAppendIsValid(complaintId) {
      let previous = 'evidence' in resource.data ? resource.data.evidence : [];
      let next = request.resource.data.evidence;
      return resource.data.status in ['Submitted', 'Under Review']
        && next is list
        && next.size() > previous.size()
        && next.size() <= 3
        && next.hasAll(previous)
        && evidenceIsValid(request.resource.data, complaintId)
        && request.resource.data.createdByUid == resource.data.createdByUid
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['evidence', 'updatedAt']);
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && userProfileIsValid(request.resource.data, userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'citizen'
        && request.resource.data.department == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !('roleUpdatedAt' in request.resource.data)
        && !('roleUpdatedBy' in request.resource.data)
        && !('roleUpdatedByName' in request.resource.data);

      allow read: if signedIn() && (request.auth.uid == userId || isAdministrator());

      allow update: if (isAdministrator() && administratorRoleUpdateIsValid(userId))
        || (signedIn()
          && request.auth.uid == userId
          && userProfileIsValid(request.resource.data, userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.department == resource.data.department
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'updatedAt']));

      allow delete: if false;
    }

    match /roleAudit/{auditId} {
      allow read: if isAdministrator();

      allow create: if isAdministrator()
        && request.resource.data.keys().hasAll([
          'targetUid', 'targetEmail', 'targetDisplayName',
          'previousRole', 'previousDepartment', 'newRole', 'newDepartment',
          'changedByUid', 'changedByEmail', 'changedByName', 'changedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'targetUid', 'targetEmail', 'targetDisplayName',
          'previousRole', 'previousDepartment', 'newRole', 'newDepartment',
          'changedByUid', 'changedByEmail', 'changedByName', 'changedAt'
        ])
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.targetEmail is string
        && request.resource.data.targetDisplayName is string
        && isValidRole(request.resource.data.previousRole)
        && request.resource.data.previousDepartment is string
        && isValidRole(request.resource.data.newRole)
        && roleDepartmentIsValid(
          request.resource.data.newRole,
          request.resource.data.newDepartment
        )
        && request.resource.data.changedByUid == request.auth.uid
        && request.resource.data.changedByEmail == request.auth.token.email
        && request.resource.data.changedByName == currentUser().data.displayName
        && request.resource.data.changedAt == request.time;

      allow update, delete: if false;
    }

    match /complaints/{complaintId} {
      allow create: if hasRole('citizen')
        && complaintFieldsAreComplete(request.resource.data)
        && complaintFieldsHaveValidTypes(request.resource.data, complaintId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.citizenName == currentUser().data.displayName
        && request.resource.data.status == 'Submitted'
        && request.resource.data.resolutionNote == ''
        && request.resource.data.rating == null
        && request.resource.data.feedback == ''
        && request.resource.data.evidence is list
        && request.resource.data.evidence.size() == 0
        && 'locationData' in request.resource.data
        && 'sla' in request.resource.data
        && newSlaIsValid(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && initialHistoryIsValid(request.resource.data);

      allow read: if isAdministrator()
        || ownsComplaint(resource.data)
        || isAssignedDepartment(resource.data);

      allow update: if (isAdministrator()
          && officialProgressUpdateIsValid(complaintId)
          && request.resource.data.priority in ['High', 'Medium', 'Low']
          && isValidDepartment(request.resource.data.department)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolutionNote', 'priority', 'department', 'updatedAt', 'statusHistory']))
        || (isAssignedDepartment(resource.data)
          && officialProgressUpdateIsValid(complaintId)
          && request.resource.data.department == resource.data.department
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolutionNote', 'updatedAt', 'statusHistory']))
        || (ownsComplaint(resource.data)
          && citizenEvidenceAppendIsValid(complaintId))
        || (ownsComplaint(resource.data)
          && resource.data.status == 'Resolved'
          && citizenFeedbackUpdateIsValid());

      allow delete: if isAdministrator();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
