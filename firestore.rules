rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn() && currentUser().data.role == role;
    }

    function isAdministrator() {
      return hasRole('administrator');
    }

    function isDepartmentOfficer() {
      return hasRole('department-officer');
    }

    function ownsComplaint(data) {
      return signedIn() && data.createdByUid == request.auth.uid;
    }

    function isAssignedDepartment(data) {
      return isDepartmentOfficer()
        && currentUser().data.department is string
        && currentUser().data.department == data.department;
    }

    function isValidRole(role) {
      return role in ['citizen', 'department-officer', 'administrator'];
    }

    function isValidDepartment(department) {
      return department in [
        'Public Works Department', 'Municipal Waste Department',
        'Water Supply Department', 'Electricity Department',
        'Sanitation Department', 'Transport Department',
        'Municipal Corporation', 'General Administration'
      ];
    }

    function roleDepartmentIsValid(role, department) {
      return (role == 'citizen' && department == '')
        || (role == 'department-officer' && isValidDepartment(department))
        || (role == 'administrator' && department == 'General Administration');
    }

    function userProfileIsValid(data, userId) {
      let required = [
        'uid', 'email', 'displayName', 'phone', 'role', 'department',
        'createdAt', 'updatedAt'
      ];
      let permitted = [
        'uid', 'email', 'displayName', 'phone', 'role', 'department',
        'createdAt', 'updatedAt', 'roleUpdatedAt', 'roleUpdatedBy',
        'roleUpdatedByName'
      ];
      return data.keys().hasAll(required)
        && data.keys().hasOnly(permitted)
        && data.uid == userId
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 120
        && data.phone is string
        && data.phone.size() <= 20
        && isValidRole(data.role)
        && data.department is string
        && roleDepartmentIsValid(data.role, data.department)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('roleUpdatedAt' in data) || data.roleUpdatedAt is timestamp)
        && (!('roleUpdatedBy' in data) || data.roleUpdatedBy is string)
        && (!('roleUpdatedByName' in data) || data.roleUpdatedByName is string);
    }

    function administratorRoleUpdateIsValid(userId) {
      return request.auth.uid != userId
        && userProfileIsValid(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.roleUpdatedAt == request.time
        && request.resource.data.roleUpdatedBy == request.auth.uid
        && request.resource.data.roleUpdatedByName == currentUser().data.displayName
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'department', 'updatedAt', 'roleUpdatedAt', 'roleUpdatedBy', 'roleUpdatedByName']);
    }

    function complaintFieldsAreComplete(data) {
      let fields = [
        'id', 'citizenName', 'email', 'phone', 'title', 'description',
        'location', 'category', 'department', 'priority', 'status',
        'expectedResolutionDate', 'resolutionNote', 'rating', 'feedback',
        'duplicateId', 'createdByUid', 'createdByEmail', 'createdAt',
        'updatedAt', 'statusHistory'
      ];
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function complaintFieldsHaveValidTypes(data, complaintId) {
      return data.id is string
        && data.id == complaintId
        && data.id.size() <= 80
        && data.citizenName is string
        && data.citizenName.size() >= 2
        && data.citizenName.size() <= 120
        && data.email is string
        && data.email.size() <= 254
        && data.phone is string
        && data.phone.size() <= 20
        && data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 160
        && data.description is string
        && data.description.size() >= 15
        && data.description.size() <= 5000
        && data.location is string
        && data.location.size() >= 3
        && data.location.size() <= 500
        && data.category is string
        && data.category.size() <= 100
        && data.department in [
          'Public Works Department', 'Municipal Waste Department',
          'Water Supply Department', 'Electricity Department',
          'Sanitation Department', 'Transport Department',
          'Municipal Corporation', 'General Administration'
        ]
        && data.priority in ['High', 'Medium', 'Low']
        && data.status in ['Submitted', 'Under Review', 'Assigned', 'In Progress', 'Resolved']
        && data.expectedResolutionDate is string
        && data.expectedResolutionDate.size() == 10
        && data.resolutionNote is string
        && data.resolutionNote.size() <= 3000
        && (data.rating == null || (data.rating is int && data.rating >= 1 && data.rating <= 5))
        && data.feedback is string
        && data.feedback.size() <= 1000
        && data.duplicateId is string
        && data.duplicateId.size() <= 80
        && data.createdByUid is string
        && data.createdByEmail is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.statusHistory is list
        && data.statusHistory.size() >= 1
        && data.statusHistory.size() <= 100;
    }

    function initialHistoryIsValid(data) {
      let entry = data.statusHistory[0];
      return data.statusHistory.size() == 1
        && entry.status == 'Submitted'
        && entry.note is string
        && entry.note.size() <= 3000
        && entry.changedAt is timestamp
        && entry.changedByUid == request.auth.uid
        && entry.changedByName is string
        && entry.changedByRole == 'citizen';
    }

    function historyAppendIsValid() {
      let newHistory = request.resource.data.statusHistory;
      let oldHistory = resource.data.statusHistory;
      let entry = newHistory[newHistory.size() - 1];
      return newHistory.size() == oldHistory.size() + 1
        && newHistory.hasAll(oldHistory)
        && entry.status == request.resource.data.status
        && entry.note is string
        && entry.note.size() <= 3000
        && entry.changedAt is timestamp
        && entry.changedByUid == request.auth.uid
        && entry.changedByName is string
        && entry.changedByRole == currentUser().data.role;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && userProfileIsValid(request.resource.data, userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'citizen'
        && request.resource.data.department == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !('roleUpdatedAt' in request.resource.data)
        && !('roleUpdatedBy' in request.resource.data)
        && !('roleUpdatedByName' in request.resource.data);

      allow read: if signedIn() && (request.auth.uid == userId || isAdministrator());

      allow update: if (isAdministrator() && administratorRoleUpdateIsValid(userId))
        || (signedIn()
          && request.auth.uid == userId
          && userProfileIsValid(request.resource.data, userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.department == resource.data.department
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'updatedAt']));

      allow delete: if false;
    }

    match /roleAudit/{auditId} {
      allow read: if isAdministrator();

      allow create: if isAdministrator()
        && request.resource.data.keys().hasAll([
          'targetUid', 'targetEmail', 'targetDisplayName',
          'previousRole', 'previousDepartment', 'newRole', 'newDepartment',
          'changedByUid', 'changedByEmail', 'changedByName', 'changedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'targetUid', 'targetEmail', 'targetDisplayName',
          'previousRole', 'previousDepartment', 'newRole', 'newDepartment',
          'changedByUid', 'changedByEmail', 'changedByName', 'changedAt'
        ])
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.targetEmail is string
        && request.resource.data.targetDisplayName is string
        && isValidRole(request.resource.data.previousRole)
        && request.resource.data.previousDepartment is string
        && isValidRole(request.resource.data.newRole)
        && roleDepartmentIsValid(
          request.resource.data.newRole,
          request.resource.data.newDepartment
        )
        && request.resource.data.changedByUid == request.auth.uid
        && request.resource.data.changedByEmail == request.auth.token.email
        && request.resource.data.changedByName == currentUser().data.displayName
        && request.resource.data.changedAt == request.time;

      allow update, delete: if false;
    }

    match /complaints/{complaintId} {
      allow create: if hasRole('citizen')
        && complaintFieldsAreComplete(request.resource.data)
        && complaintFieldsHaveValidTypes(request.resource.data, complaintId)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.citizenName == currentUser().data.displayName
        && request.resource.data.status == 'Submitted'
        && request.resource.data.resolutionNote == ''
        && request.resource.data.rating == null
        && request.resource.data.feedback == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && initialHistoryIsValid(request.resource.data);

      allow read: if isAdministrator()
        || ownsComplaint(resource.data)
        || isAssignedDepartment(resource.data);

      allow update: if (isAdministrator()
          && complaintFieldsAreComplete(request.resource.data)
          && complaintFieldsHaveValidTypes(request.resource.data, complaintId)
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.createdByEmail == resource.data.createdByEmail
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolutionNote', 'priority', 'department', 'updatedAt', 'statusHistory'])
          && historyAppendIsValid())
        || (isAssignedDepartment(resource.data)
          && complaintFieldsAreComplete(request.resource.data)
          && complaintFieldsHaveValidTypes(request.resource.data, complaintId)
          && request.resource.data.department == resource.data.department
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolutionNote', 'updatedAt', 'statusHistory'])
          && historyAppendIsValid())
        || (ownsComplaint(resource.data)
          && resource.data.status == 'Resolved'
          && complaintFieldsAreComplete(request.resource.data)
          && complaintFieldsHaveValidTypes(request.resource.data, complaintId)
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'feedback', 'updatedAt']));

      allow delete: if isAdministrator();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
